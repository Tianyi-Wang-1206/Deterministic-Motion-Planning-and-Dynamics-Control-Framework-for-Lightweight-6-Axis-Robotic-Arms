# 1. GOAL: Request sent from client to planner

# List of supported motion types
uint8 MOVEJ = 0
uint8 MOVEP = 1
uint8 MOVEL = 2
uint8 MOVEC = 3

uint8 command_type

# Target specification
float64[6] joint_target
geometry_msgs/Pose pose_target
geometry_msgs/Pose pose_aux 

# Global scaling factors for velocity and acceleration (0.01 ~ 1.0)
float64 velocity_scale
float64 acceleration_scale

---

# 2. RESULT: Response sent from planner to client

# Definition of error codes
int32 SUCCESS = 1
int32 ERR_INVALID_INPUT = -1
int32 ERR_NO_IK_SOLUTION = -2
int32 ERR_LIMIT_VIOLATION = -3
int32 ERR_SINGULARITY = -4
int32 ERR_QUADRANT_JUMP = -5
int32 ERR_RUCKIG_FAILED = -6
int32 ERR_EXECUTION_ABORTED = -7

int32 error_code
string error_string

# Total execution time of the motion (in seconds)
float64 execution_time

---

# 3. FEEDBACK: Real-time progress updates sent from planner to client

# State stage enumeration
uint8 STATE_PLANNING = 0
uint8 STATE_EXECUTING = 1

uint8 current_state

# Progress percentage (0.0 ~ 100.0)
float64 percent_complete